# Database — required
# Local:    postgresql://user:password@localhost:5432/visionnova
# Supabase: use the Transaction Pooler URL from Project Settings > Database > Connection string
#           Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/visionnova

# Session signing, and the short-lived pending-login cookie used by the login
# OTP step — REQUIRED. In production the app refuses to start without it
# rather than falling back to the development constant published in this repo
# (see src/lib/requiredSecret.ts); that fallback would have made session
# forgery trivial for anyone with source access. Use a random 32+ char
# string, unique per environment.
SESSION_SECRET=change-me-in-production

# Stripe — required for payment processing
# Get from https://dashboard.stripe.com/test/apikeys (use test keys for development)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret — required for webhook signature verification
# Generate with: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay — required for payments in the IN region
# Get from https://dashboard.razorpay.com/app/keys (use test mode for development)
# KEY_SECRET doubles as the REST API Basic Auth password and signs the
# client-side payment confirmation.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Sentry — required for error tracking AND for CSP violation reports.
# Get from Project Settings > Client Keys (DSN).
# The CSP report endpoint is derived from this value (see src/lib/csp.mjs), so
# without it the Content-Security-Policy-Report-Only header collects nothing
# and the watch period observes no violations at all.
NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>

# Resend — required for transactional email (order confirmation, shipping,
# prescription status). Get from https://resend.com/api-keys
# Without it, sends fail; the webhooks report the failure and still return 200,
# so a payment is never retried because of a mail outage — but no email is sent.
RESEND_API_KEY=re_...

# Razorpay Webhook Secret — required for webhook signature verification.
# This is a SEPARATE secret from KEY_SECRET: you choose it yourself when creating
# the webhook under Settings > Webhooks. X-Razorpay-Signature is an HMAC-SHA256
# of the raw request body using this value, not KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=...

# Grievance Officer contact — REQUIRED under India's DPDP Act, which mandates
# a named, reachable contact point for data-protection grievances. Rendered
# in the site footer (src/components/layout/Footer.tsx). Without these set,
# the footer visibly flags the contact as unconfigured rather than silently
# omitting it — but that means the statutory requirement isn't actually met
# until real values are set here. Get the real name/email/phone from legal
# or compliance before deploying; do not invent placeholder people.
GRIEVANCE_OFFICER_NAME=Jane Doe
GRIEVANCE_OFFICER_EMAIL=grievance@visionnova.com
GRIEVANCE_OFFICER_PHONE=+91-XX-XXXX-XXXX

# Upstash Redis — required for rate limiting on register/login (5 attempts/min/IP).
# Get from https://console.upstash.com (REST API, not the TCP connection string —
# this is called over HTTP by design, since a normal Redis client's persistent
# TCP connection doesn't survive a serverless function's per-request lifecycle).
# Without these set, checkRateLimit throws immediately rather than silently
# running with no rate limiting at all.
UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Encryption-at-rest keys — REQUIRED for KYC documents (src/lib/kycStorage.ts)
# and prescription files (src/lib/prescriptionStorage.ts). Read lazily, so in
# production the first read or write of a document throws naming the missing
# variable rather than encrypting health data with a key published in this
# repo's own source (see src/lib/requiredSecret.ts). Note this fails at first
# use, NOT at startup — a deploy missing these looks healthy until someone
# uploads. Set a random 32+ char string per environment, and use DIFFERENT
# values for the two keys (a compromise of one must not expose the other).
KYC_ENCRYPTION_KEY=change-me-in-production
PRESCRIPTION_ENCRYPTION_KEY=change-me-in-production

# Regulatory risk register (rendered on /admin/compliance) — these represent
# real-world business/legal/staffing actions code cannot perform. Each stays
# visibly flagged as "Not configured" on the compliance console until the
# real action happens and the flag is set. Do NOT set these until the action
# has genuinely occurred — the console's whole purpose is making outstanding
# regulatory work impossible to miss.
#
# Set once legal/compliance has WRITTEN confirmation from the regulator that
# the establishment registration for selling prescription eyewear is complete
# (Risk R-01 / REG-01). Value is the confirmation date, e.g. 2026-09-01.
# REGULATORY_ESTABLISHMENT_REGISTRATION_CONFIRMED_AT=
#
# Set once a second payment processor is actually contracted AND its provider
# adapter is implemented in src/lib/payments/ (Risk TECH-01 / FIN-04) —
# checkout currently has a single processor per region.
# BACKUP_PAYMENT_PROCESSOR_NAME=
#
# Number of licensed optometrists on staff (Risk OPS-04 / PEO-02). The
# compliance console flags anything below 2 — a single optometrist is a
# single point of failure for the Rx review queue.
# LICENSED_OPTOMETRIST_COUNT=1

# Local development only. Next.js rejects Server Action POSTs whose `Origin`
# host differs from the `Host`/`x-forwarded-host` header ("Invalid Server
# Actions request."). Direct localhost browsing is already allowed; set this
# only when a proxy, tunnel or editor-forwarded port serves the dev app on
# some other host. Comma-separated, include the port, e.g.
# SERVER_ACTIONS_ALLOWED_ORIGINS=myapp-3000.devtunnels.ms,192.168.1.5:3000
# Ignored entirely in production, where the strict same-host check stands.
# SERVER_ACTIONS_ALLOWED_ORIGINS=
