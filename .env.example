# Database — required
# Local:    postgresql://user:password@localhost:5432/visionnova
# Supabase: use the Transaction Pooler URL from Project Settings > Database > Connection string
#           Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/visionnova

# Session signing — required (use a random 32+ char string in production)
SESSION_SECRET=change-me-in-production

# Stripe — required for payment processing
# Get from https://dashboard.stripe.com/test/apikeys (use test keys for development)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret — required for webhook signature verification
# Generate with: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay — required for payments in the IN region
# Get from https://dashboard.razorpay.com/app/keys (use test mode for development)
# KEY_SECRET doubles as the REST API Basic Auth password and signs the
# client-side payment confirmation.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Sentry — required for error tracking AND for CSP violation reports.
# Get from Project Settings > Client Keys (DSN).
# The CSP report endpoint is derived from this value (see src/lib/csp.mjs), so
# without it the Content-Security-Policy-Report-Only header collects nothing
# and the watch period observes no violations at all.
NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>

# Resend — required for transactional email (order confirmation, shipping,
# prescription status). Get from https://resend.com/api-keys
# Without it, sends fail; the webhooks report the failure and still return 200,
# so a payment is never retried because of a mail outage — but no email is sent.
RESEND_API_KEY=re_...

# Razorpay Webhook Secret — required for webhook signature verification.
# This is a SEPARATE secret from KEY_SECRET: you choose it yourself when creating
# the webhook under Settings > Webhooks. X-Razorpay-Signature is an HMAC-SHA256
# of the raw request body using this value, not KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=...

# Grievance Officer contact — REQUIRED under India's DPDP Act, which mandates
# a named, reachable contact point for data-protection grievances. Rendered
# in the site footer (src/components/layout/Footer.tsx). Without these set,
# the footer visibly flags the contact as unconfigured rather than silently
# omitting it — but that means the statutory requirement isn't actually met
# until real values are set here. Get the real name/email/phone from legal
# or compliance before deploying; do not invent placeholder people.
GRIEVANCE_OFFICER_NAME=Jane Doe
GRIEVANCE_OFFICER_EMAIL=grievance@visionnova.com
GRIEVANCE_OFFICER_PHONE=+91-XX-XXXX-XXXX

# Upstash Redis — required for rate limiting on register/login (5 attempts/min/IP).
# Get from https://console.upstash.com (REST API, not the TCP connection string —
# this is called over HTTP by design, since a normal Redis client's persistent
# TCP connection doesn't survive a serverless function's per-request lifecycle).
# Without these set, checkRateLimit throws immediately rather than silently
# running with no rate limiting at all.
UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=...
